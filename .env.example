# SeatScout broker API credentials
#
# SeatScout runs fully without any keys — every broker falls back to a built-in
# deterministic mock feed so you can develop and demo offline. To pull LIVE data
# from a broker, set its key(s) below and the matching adapter will switch from
# mock mode to live mode automatically.
#
# Most ticket-broker / marketplace APIs are partner-gated. Apply for access via
# each provider's developer / affiliate program, then drop the credentials here.

# SeatGeek Platform API  -> https://platform.seatgeek.com/
SEATGEEK_CLIENT_ID=
SEATGEEK_CLIENT_SECRET=

# Ticketmaster Discovery API -> https://developer.ticketmaster.com/
TICKETMASTER_API_KEY=

# StubHub Partner API -> https://developer.stubhub.com/
STUBHUB_APP_TOKEN=

# Vivid Seats Affiliate / Skybox API (partner-gated)
VIVIDSEATS_API_KEY=

# Gametime (partner-gated)
GAMETIME_API_KEY=

# TickPick (partner-gated)
TICKPICK_API_KEY=

# TicketsData — unified real-time listings across 10 marketplaces
# (Ticketmaster, StubHub, SeatGeek, Vivid Seats, Gametime, TickPick, Viagogo,
# Dice, Eventbrite, AXS). https://ticketsdata.com/docs
# When set, the event detail page shows real seat-level inventory.
TICKETSDATA_USERNAME=
TICKETSDATA_PASSWORD=
